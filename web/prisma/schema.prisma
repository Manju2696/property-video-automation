generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  photoPath String?
  logoPath  String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id             Int      @id @default(autoincrement())
  name           String
  beds           Int?
  baths          Int?
  sqft           Int?
  listingPrice   Float?
  agentId        Int?
  agent          Agent?   @relation(fields: [agentId], references: [id])
  status         String   @default("uploading")
  introTemplate  String   @default("A")
  outroTemplate  String   @default("1")
  animationStyle String   @default("fade_in")
  musicTrack     String?
  musicVolume    Float    @default(0.5)
  photoDuration  Float    @default(4.0)
  zoomIntensity  Float    @default(1.2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  photos         Photo[]
}

model Photo {
  id            Int      @id @default(autoincrement())
  projectId     Int
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath      String
  roomType      String?
  confidence    Float?
  sequenceOrder Int?
  zoomDirection String   @default("in")
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
}
